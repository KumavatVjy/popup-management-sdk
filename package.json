{
  "name": "popup-manager-sdk",
  "version": "0.1.0",
  "description": "Lightweight, zero-dependency browser SDK for the Popup Management System",
  "private": true,
  "type": "module",
  "main": "dist/popup-manager.min.js",
  "module": "dist/popup-manager.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/config.test.js && node test/smoke.js",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
